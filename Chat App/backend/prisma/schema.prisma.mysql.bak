datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum GroupRole {
  OWNER
  ADMIN
  MEMBER
}

enum MessageType {
  TEXT
  IMAGE
  VIDEO
  FILE
  VOICE
  AI
}

model User {
  id           String         @id @default(uuid())
  name         String
  username     String         @unique
  email        String         @unique
  passwordHash String
  profileImage String?        @db.VarChar(512)
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  refreshTokens RefreshToken[]
  ownedGroups   Group[]        @relation("GroupOwner")
  memberships   GroupMember[]
  messages      Message[]
  groupPins     GroupPin[]
  blockedUsers  BlockedUser[]  @relation("BlockerRelation")
  blockedBy     BlockedUser[]  @relation("BlockedRelation")
  messageReceipts MessageReceipt[]

  @@index([username])
  @@index([email])
}

model RefreshToken {
  id        String    @id @default(uuid())
  tokenHash String    @unique
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([tokenHash])
}

model Group {
  id          String        @id @default(uuid())
  name        String        @db.VarChar(100)
  description String?       @db.Text
  image       String?       @db.VarChar(512)
  avatarUrl   String?       @db.VarChar(512)
  createdBy   String?
  ownerId     String
  owner       User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  members     GroupMember[]
  messages    Message[]
  groupPins   GroupPin[]

  @@index([ownerId])
  @@index([createdBy])
  @@index([updatedAt])
}

model GroupPin {
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  groupId  String
  group    Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  pinnedAt DateTime @default(now())

  @@id([userId, groupId])
  @@index([userId])
  @@index([groupId])
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blocker   User     @relation("BlockerRelation", fields: [blockerId], references: [id], onDelete: Cascade)
  blockedId String
  blocked   User     @relation("BlockedRelation", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model GroupMember {
  id        String    @id @default(uuid())
  groupId   String
  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      GroupRole @default(MEMBER)
  joinedAt  DateTime  @default(now())

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId, role])
}

model Message {
  id        String      @id @default(uuid())
  groupId   String
  group     Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  senderId  String?
  sender    User?       @relation(fields: [senderId], references: [id], onDelete: SetNull)
  type      MessageType @default(TEXT)
  text      String?     @db.LongText
  content   String?     @db.LongText
  fileUrl   String?     @db.VarChar(512)
  fileKey   String?     @db.VarChar(255)
  fileName  String?     @db.VarChar(255)
  fileSize  Int?
  mimeType  String?     @db.VarChar(100)
  duration  Float?
  fileInfo  Json?
  isPinned  Boolean     @default(false)
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  receipts  MessageReceipt[]

  @@index([groupId])
  @@index([senderId])
  @@index([createdAt])
  @@index([groupId, createdAt(sort: Desc)])
}

model MessageReceipt {
  id          String    @id @default(uuid())
  messageId   String
  message     Message   @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  deliveredAt DateTime?
  readAt      DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([messageId, userId])
  @@index([messageId])
  @@index([userId])
}
