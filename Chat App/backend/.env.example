# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# Database Connection (MySQL)
DATABASE_URL="mysql://root:@localhost:3306/chat_app"

# JWT Configuration
JWT_ACCESS_SECRET="your-32-char-secret-jwt-access-key-here"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-32-char-secret-jwt-refresh-key-here"
JWT_REFRESH_EXPIRES_IN="7d"

# File Storage Configuration (local, s3, or cloudinary)
STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"

# S3 Compatible Storage (optional when STORAGE_PROVIDER=s3)
# S3_BUCKET_NAME=my-chat-app-bucket
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=your-s3-access-key-id
# S3_SECRET_ACCESS_KEY=your-s3-secret-access-key
# S3_ENDPOINT=https://s3.amazonaws.com

# Cloudinary Storage (optional when STORAGE_PROVIDER=cloudinary)
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-cloudinary-api-key
# CLOUDINARY_API_SECRET=your-cloudinary-api-secret

