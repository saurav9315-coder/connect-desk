# ========================================================
# Root Environment Template: Simple Group Chat with AI
# ========================================================
# Copy backend variables to backend/.env
# Copy frontend variables to frontend/.env.local

# -----------------
# BACKEND CONFIGURATION (backend/.env)
# -----------------
PORT=5001
NODE_ENV=development
DATABASE_URL="mysql://root:password@localhost:3306/chat_app"
CLIENT_ORIGIN="http://localhost:3000"

JWT_ACCESS_SECRET="your-32-character-secret-access-token-key-here"
JWT_ACCESS_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="your-32-character-secret-refresh-token-key-here"
JWT_REFRESH_EXPIRES_IN="7d"

STORAGE_PROVIDER="local"
UPLOAD_DIR="./uploads"

AI_PROVIDER="mock"
GEMINI_API_KEY=""
OPENAI_API_KEY=""

# -----------------
# FRONTEND CONFIGURATION (frontend/.env.local)
# -----------------
NEXT_PUBLIC_API_URL="http://localhost:5001/api"
NEXT_PUBLIC_SOCKET_URL="http://localhost:5001"
NEXT_PUBLIC_APP_NAME="Simple Group Chat with AI"
